{
  "name": "@episuarez/init-claude",
  "version": "1.2.0",
  "description": "One command to configure Claude Code for any project: detects stack, installs MCPs, writes CLAUDE.md.",
  "type": "module",
  "bin": {
    "init-claude": "dist/init-claude.js"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:dist": "tsup && git -c core.fileMode=false diff --exit-code dist",
    "build:readme": "node scripts/gen-readme.mjs",
    "check:readme": "node scripts/gen-readme.mjs && git diff --exit-code README.md",
    "prepare": "husky || exit 0",
    "prepublishOnly": "tsup"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "claude-code",
    "claude",
    "anthropic",
    "mcp",
    "cli",
    "developer-tools",
    "ai",
    "init"
  ],
  "author": "Epifanio Suárez Martínez <11500823+episuarez@users.noreply.github.com>",
  "license": "MIT",
  "homepage": "https://github.com/episuarez/initialiser#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/episuarez/initialiser.git"
  },
  "bugs": {
    "url": "https://github.com/episuarez/initialiser/issues"
  },
  "files": [
    "dist/",
    "catalog/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "picocolors": "^1.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "allowScripts": {
    "esbuild@0.27.7": true
  },
  "overrides": {
    "esbuild": "0.27.7"
  }
}
